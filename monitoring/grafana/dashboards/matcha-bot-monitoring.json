    {
      "id": 36,
      "type": "row",
      "title": "Usage limits",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 77
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Daily limit hits (24h)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 78
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
