{
  "uid": "matcha-overview",
  "title": "Matcha Bot Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Agent",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total[5m])) by (model, kind)",
          "refId": "A",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node latency p95",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_node_duration_seconds_bucket[5m])) by (le, node))",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Estimated cost (24h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [{ "expr": "sum(increase(llm_cost_usd_total[24h]))", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retrieved chunks (avg)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(retrieve_chunks_returned_sum[5m]) / clamp_min(rate(retrieve_chunks_returned_count[5m]), 0.001)",
          "refId": "A",
          "legendFormat": "chunks"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Cost by call type (24h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "options": { "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(llm_cost_usd_total[24h])) by (call_type)",
          "refId": "A",
          "legendFormat": "{{call_type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Call outcomes",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(llm_calls_total[5m])) by (outcome)",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(llm_retries_total[5m])) by (call_type)",
          "refId": "A",
          "legendFormat": "{{call_type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Extraction outcomes",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(extraction_runs_total[5m])) by (extractor, outcome)",
          "refId": "A",
          "legendFormat": "{{extractor}} {{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Summarize runs",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(summarize_runs_total[5m])) by (outcome)",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Daily limit hits (24h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(increase(daily_token_limit_hits_total[24h]))", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Telegram",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Messages per minute",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(telegram_messages_total[5m])) by (channel_id, direction) * 60",
          "refId": "A",
          "legendFormat": "{{channel_id}} {{direction}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Poll errors",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(telegram_poll_errors_total[5m])) by (channel_id)",
          "refId": "A",
          "legendFormat": "{{channel_id}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (handler)",
          "refId": "A",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Status codes",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status)",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Latency p50",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Host",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 73 }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Targets up",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 74 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(up)", "refId": "A" }]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Active channels",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "active_channels", "refId": "A" }]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Host CPU usage",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 74 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "refId": "A",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Host memory usage",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 74 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "refId": "A",
          "legendFormat": "memory"
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Root disk free",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 82 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/rootfs\",fstype!~\"tmpfs|overlay\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
