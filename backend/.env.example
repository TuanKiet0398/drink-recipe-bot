# Copy to backend/.env and fill in real values. Never commit the real .env.

# OpenAI API key — used for retrieve/generate calls and doc-chunk embeddings.
OPENAI_API_KEY=sk-your-openai-api-key

# Directory where the Chroma vector DB is persisted.
CHROMA_PERSIST_DIR=./chroma_db

# Base64-encoded 32-byte key (AES-256-GCM) used to encrypt each channel's bot token.
# Generate one with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# DB connection string. Defaults to SQLite; swap for a Postgres URL in production.
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql://user:password@host:5432/matcha_bot

# Admin dashboard login (HTTP Basic Auth) — change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
