# goclaw/ is a separate, unrelated git repository that happens to sit
# inside this project's working directory — never part of this repo.
goclaw/

# Secrets — never commit, regardless of which directory they're in.
.env
.env.*
!.env.example
!.env.prod.example

# Terraform — state holds resource IDs and can hold secret values.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/.terraform.lock.hcl
infra/terraform.tfvars
